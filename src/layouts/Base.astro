---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, SITE_NAME, APP_ID, GA4_ID, ORG_ID, WEBSITE_ID, SOCIAL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-default.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE_URL).toString();

const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: SITE_NAME,
      url: SITE_URL,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/apple-touch-icon.png`, width: 180, height: 180 },
      sameAs: [SOCIAL.instagram, SOCIAL.twitter],
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      name: SITE_NAME,
      url: SITE_URL,
      inLanguage: 'en-IE',
      publisher: { '@id': ORG_ID },
    },
  ],
};
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, follow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#169b62" />
    <meta name="apple-itunes-app" content={`app-id=${APP_ID.replace('id', '')}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&display=swap"
      />
    </noscript>
    <meta name="author" content="Yigit Yilmaz" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MovingIreland" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}${ogImage}`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph)} />
    <slot name="head" />
    {
      GA4_ID && (
        <script is:inline define:vars={{ GA4_ID, APP_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA4_ID);
          var gtagLoaded = false;
          function loadGtag() {
            if (gtagLoaded) return;
            gtagLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
            document.head.appendChild(s);
          }
          var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
          function onFirst() {
            events.forEach(function (ev) { window.removeEventListener(ev, onFirst); });
            loadGtag();
          }
          events.forEach(function (ev) {
            window.addEventListener(ev, onFirst, { passive: true, once: true });
          });
          if ('requestIdleCallback' in window) requestIdleCallback(loadGtag, { timeout: 5000 });
          else setTimeout(loadGtag, 4000);
          document.addEventListener('click', function (e) {
            var link = e.target.closest('a[href*="apps.apple.com"]');
            if (!link) return;
            gtag('event', 'app_store_click', {
              placement: link.getAttribute('data-placement') || 'unknown',
              page_path: window.location.pathname,
            });
          });
        </script>
      )
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:m-2 focus:rounded-md focus:bg-brand focus:px-4 focus:py-3 focus:text-white"
    >
      Skip to content
    </a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
